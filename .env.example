# Copy this file to .env and fill in your Upstox app credentials.
# Get them from https://account.upstox.com/developer/apps
# .env is git-ignored - never commit the real file.

UPSTOX_API_KEY=your-app-api-key
UPSTOX_API_SECRET=your-app-secret
# Must exactly match the redirect URI configured on your Upstox app:
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback
